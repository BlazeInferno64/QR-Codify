  <div class="modal fade" id="generateModal" tabindex="-1" aria-labelledby="generateModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-fullscreen-sm-down">
      <div class="modal-content border-0 shadow-lg">
        <div class="modal-header px-3 py-3">
          <div>
            <h5 class="modal-title text-white" id="generateModalLabel">Generate a QR code</h5>
            <p class="small mb-0" style="color: var(--md-on-surface-variant);">Generate a QR code from text or a URL easily!</p>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body p-3">
          <div class="row g-3">
            <!-- Live Preview: top on mobile, right on desktop -->
            <div class="col-lg-6 order-1 order-lg-2 d-flex flex-column">
              <div class="md-card md-card--tight p-3 text-center h-100 d-flex flex-column justify-content-center">
                <div class="d-flex align-items-center justify-content-center gap-2 mb-2">
                  <span class="material-symbols-outlined" style="font-size: 1.15rem; color: var(--md-primary);">visibility</span>
                  <div class="md-label mb-0" style="font-weight: 700; letter-spacing: 0.02em;">Live Preview</div>
                </div>
                <div class="qr-box mb-3 mx-auto" style="max-width: 260px;">
                  <img id="modalQrPreview"
                    src="/api/generate?data=QR%20Codify&size=500x500"
                    alt="QR code live preview" class="img-fluid" />
                </div>
                <div class="small" style="color: var(--md-on-surface-variant); font-size: 0.78rem;">
                  Click Update QR to refresh the preview.
                </div>
              </div>
            </div>
            <!-- Form fields: below on mobile, left on desktop -->
            <div class="col-lg-6 order-2 order-lg-1">
              <div class="md-card md-card--tight p-3 mb-2.5">
                <label for="generateText" class="form-label fw-semibold">Text / URL to encode</label>
                <textarea id="generateText" class="form-control" rows="3" placeholder="https://example.com"></textarea>
              </div>
              <div class="md-card md-card--tight p-3 mb-2.5">
                <label for="generateTheme" class="form-label fw-semibold">Visual theme</label>
                <select id="generateTheme" class="form-select">
                  <option value="">Default (Modern Mono)</option>
                  <option value="cyber">Cyber Gradient</option>
                  <option value="tokyonight">Tokyo Night</option>
                  <option value="neon">Neon Lime</option>
                  <option value="glitch">Glitch Matrix</option>
                </select>
              </div>
              <div class="md-card md-card--tight p-3 mb-2.5">
                <label for="generateSize" class="form-label fw-semibold">Resolution (px) (500
                  recommended)</label>
                <input type="number" id="generateSize" class="form-control" value="500" min="100" max="1000" />
              </div>
              <div class="md-card md-card--tight p-3">
                <label for="generateFormat" class="form-label fw-semibold">Output format</label>
                <select id="generateFormat" class="form-select">
                  <option value="png">PNG (Lossless)</option>
                  <option value="jpg">JPG (Compressed)</option>
                  <option value="svg">SVG (Scalable)</option>
                </select>
              </div>
            </div>
          </div>
        </div>

        <div class="modal-footer p-3">
          <div class="row w-100 g-2 m-0">
            <div class="col-12 col-sm-4 p-0 px-1 order-3 order-sm-1">
              <button type="button" class="md-btn md-btn--outlined md-btn--block" data-bs-dismiss="modal">Close</button>
            </div>
            <div class="col-12 col-sm-4 p-0 px-1 order-2 order-sm-2">
              <button type="button" id="updatePreviewBtn" class="md-btn md-btn--tonal md-btn--block">Update QR</button>
            </div>
            <div class="col-12 col-sm-4 p-0 px-1 order-1 order-sm-3">
              <a id="downloadQrBtn" href="/api/generate?data=QR%20Codify" download="qrcode.png"
                class="md-btn md-btn--filled md-btn--block">Download QR</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="apiExampleModal" tabindex="-1" aria-labelledby="apiExampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl modal-fullscreen-sm-down">
      <div class="modal-content border-0 shadow-lg">
        <div class="modal-header px-3 py-3">
          <div>
            <h5 class="modal-title text-white" id="apiExampleModalLabel">Developer API usage</h5>
            <p class="small mb-0" style="color: var(--md-on-surface-variant);">No auth required — zero data retention setup.
            </p>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body p-3">
          <!-- API Tabs -->
          <div class="mb-3">
            <div class="d-flex gap-2" style="border-bottom: none;">
              <button id="generateApiTab" class="md-btn md-btn--text md-btn--sm api-tab-btn active" style="border: 2px solid var(--md-primary); border-radius: 8px;">Generate API</button>
              <button id="readApiTab" class="md-btn md-btn--text md-btn--sm api-tab-btn">Read API</button>
            </div>
          </div>

          <!-- Generate API Tab -->
          <div id="generateApiContent" class="md-card md-card--tight p-2 p-sm-3">
            <h6 class="fw-semibold mb-2 text-white" style="font-size: 0.8rem;">POST /api/generate — Returns raw image data (PNG, JPG, SVG)</h6>
            <div class="api-code-wrapper">
              <pre class="language-js"><code id="fetchExampleCode" class="language-js"></code></pre>
            </div>
          </div>

          <!-- Read API Tab -->
          <div id="readApiContent" class="md-card md-card--tight p-2 p-sm-3" style="display: none;">
            <h6 class="fw-semibold mb-2 text-white" style="font-size: 0.8rem;">POST /api/read — Decode QR codes from images</h6>
            <div class="api-code-wrapper">
              <pre class="language-js"><code id="readExampleCode" class="language-js"></code></pre>
            </div>
          </div>
        </div>

        <div class="modal-footer p-3 d-flex flex-row gap-2">
          <button type="button" class="md-btn md-btn--outlined flex-fill" data-bs-dismiss="modal">Close</button>
          <button id="openJoltBtn" type="button" class="md-btn md-btn--filled flex-fill">
            Try in Jolt <span class="material-symbols-outlined">arrow_forward</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="scanModal" tabindex="-1" aria-labelledby="scanModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-fullscreen-sm-down">
      <div class="modal-content border-0 shadow-lg">
        <div class="modal-header px-3 py-3">
          <div>
            <h5 class="modal-title text-white" id="scanModalLabel">Scan / decode QR code</h5>
            <p class="small mb-0" style="color: var(--md-on-surface-variant);">Upload local images to decrypt content
              instantly.</p>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body p-3">
          <div class="md-card md-card--tight p-3 mb-3">
            <label class="fw-semibold mb-2 text-white small">Upload image file</label>
            <input id="scanFileInput" type="file" accept="image/*" class="form-control" />
          </div>
          <div class="md-card md-card--tight p-3">
            <h6 class="fw-semibold mb-2 text-white small">Decoded contents</h6>
            <pre id="scanResult">Waiting for target selection...</pre>
            <a id="scanOpenLink" href="#" target="_blank" rel="noopener noreferrer"
              class="md-btn md-btn--tonal md-btn--sm md-btn--block mt-2"
              style="display:none;">
              <span class="material-symbols-outlined" style="font-size:1rem;">open_in_new</span>Open link
            </a>
          </div>
        </div>

        <div class="modal-footer p-3 d-flex flex-row gap-2">
          <button type="button" class="md-btn md-btn--outlined flex-fill" data-bs-dismiss="modal">Close</button>
          <button id="decodeUploadBtn" type="button"
            class="md-btn md-btn--filled flex-fill">Decode image</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Material Design Ripple Effect
    function createRipple(event) {
      const button = event.currentTarget;
      const ripple = document.createElement('div');
      const rect = button.getBoundingClientRect();
      const size = Math.max(rect.width, rect.height);
      
      // Handle both mouse and touch events
      const x = (event.clientX || event.touches?.[0]?.clientX || 0) - rect.left - size / 2;
      const y = (event.clientY || event.touches?.[0]?.clientY || 0) - rect.top - size / 2;

      ripple.classList.add('md-ripple');
      ripple.style.width = ripple.style.height = size + 'px';
      ripple.style.left = x + 'px';
      ripple.style.top = y + 'px';

      button.appendChild(ripple);
      ripple.classList.add('active');

      setTimeout(() => ripple.remove(), 900);
    }

    document.addEventListener('DOMContentLoaded', function () {
      // Attach ripple effect to all md-btn and md-icon-btn buttons on pointerdown (mouse + touch)
      document.querySelectorAll('.md-btn, .md-icon-btn').forEach(btn => {
        btn.addEventListener('pointerdown', createRipple);
      });

      // QR preview & download link update only when the Update button is clicked
      document.getElementById('decodeUploadBtn')?.addEventListener('click', scanUploadedFile);

      function openApiModal() {
        renderFetchExample();
        renderReadExample();
        switchApiTab('generate');
        new bootstrap.Modal(document.getElementById('apiExampleModal')).show();
      }
      document.getElementById('openApiExampleBtn')?.addEventListener('click', openApiModal);
      document.getElementById('openApiExampleBtn2')?.addEventListener('click', openApiModal);
      document.getElementById('openApiExampleBtnTop')?.addEventListener('click', openApiModal);
      document.getElementById('openJoltBtn')?.addEventListener('click', openExampleInJolt);
      
      // Tab switching
      document.getElementById('generateApiTab')?.addEventListener('click', () => switchApiTab('generate'));
      document.getElementById('readApiTab')?.addEventListener('click', () => switchApiTab('read'));
    });
    
    document.getElementById("updatePreviewBtn").addEventListener("click", updateModalDownloadLink);

    function updateModalDownloadLink() {
      const textInput = document.getElementById('generateText');
      const text = textInput.value.trim() || 'QR Codify';
      const theme = document.getElementById('generateTheme')?.value || '';
      const size = document.getElementById('generateSize')?.value || '500';
      const formatElement = document.getElementById('generateFormat');
      const format = formatElement?.value || 'png';

      let previewUrl = `/api/generate?data=${encodeURIComponent(text)}&size=${size}x${size}&format=${format}`;
      let downloadUrl = previewUrl;
      if (theme) {
        previewUrl += `&theme=${theme}`;
        downloadUrl += `&theme=${theme}`;
      }
      
      const previewImg = document.getElementById('modalQrPreview');
      if (previewImg) {
        previewImg.src = previewUrl;
      }

      const downloadBtn = document.getElementById('downloadQrBtn');
      if (downloadBtn) {
        downloadBtn.href = downloadUrl;
        downloadBtn.download = `qrcode.${format}`;
      }
    }

    function renderFetchExample() {
      const code = `// REST API — no auth, no SDK needed
// Rate limit: 45 requests/min per IP

const response = await fetch('${window.location.origin}/api/generate', {
  method: 'POST',
  headers: { 'Content-Type': 'application/json' },
  body: JSON.stringify({
    data: 'Powered by QR Codify. Visit - ${window.location.origin} for more info!', // Replace with your desired data
    theme: 'cyber',  // 'cyber' | 'tokyonight' | 'neon'
    size: 600,       // pixels, 100–1000
    format: 'png',   // 'png' | 'jpg' | 'svg' (optional, defaults to png)
    // banner: 'data:image/png;base64,<your_base64_here>'
  })
});
const imageBlob = await response.blob();
const imageUrl = URL.createObjectURL(imageBlob);
console.log('QR code URL:', imageUrl);
window.open(imageUrl);`;

      const target = document.getElementById('fetchExampleCode');
      if (target) {
        target.textContent = code;
        if (window.Prism) Prism.highlightElement(target);
      }
    }

    function renderReadExample() {
      const code = `// REST API — Decode QR codes from images (PNG, JPG, etc.)
// Supports: File uploads, Base64 strings, or data URIs
// Rate limit: 45 requests/min per IP

// Decode from Base64 / Data URI
const dataUri = "data:image/png;base64,<your_base64_here>";

const response = await fetch('${window.location.origin}/api/read', {
  method: 'POST',
  headers: { 'Content-Type': 'application/json' },
  body: JSON.stringify({ image: dataUri })
});

// Decode from File Upload
/*
const formData = new FormData();
const fileInput = document.querySelector('input[type="file"]');
if (!fileInput.files[0]) return alert('Please select an image');
formData.append('image', fileInput.files[0]);

const response = await fetch('${window.location.origin}/api/read', {
  method: 'POST',
  body: formData
});
*/

const data = await response.json();

if (data.success) {
  console.log('Decoded QR:', data.response);
  alert('QR Code contains: ' + data.response);
} else {
  console.error('Error:', data.error);
  alert('Failed to decode: ' + data.error);
}`;

      const target = document.getElementById('readExampleCode');
      if (target) {
        target.textContent = code;
        if (window.Prism) Prism.highlightElement(target);
      }
    }

    function switchApiTab(tabName) {
      const generateContent = document.getElementById('generateApiContent');
      const readContent = document.getElementById('readApiContent');
      const generateTab = document.getElementById('generateApiTab');
      const readTab = document.getElementById('readApiTab');

      if (tabName === 'generate') {
        generateContent.style.display = 'block';
        readContent.style.display = 'none';
        generateTab.classList.add('active');
        generateTab.style.border = '2px solid var(--md-primary)';
        generateTab.style.borderRadius = '8px';
        readTab.classList.remove('active');
        readTab.style.border = 'none';
      } else {
        generateContent.style.display = 'none';
        readContent.style.display = 'block';
        generateTab.classList.remove('active');
        generateTab.style.border = 'none';
        readTab.classList.add('active');
        readTab.style.border = '2px solid var(--md-primary)';
        readTab.style.borderRadius = '8px';
      }
    }

    function openExampleInJolt() {
      const generateContent = document.getElementById('generateApiContent');
      let code = '';

      if (generateContent.style.display !== 'none') {
        code = document.getElementById('fetchExampleCode')?.textContent || '';
      } else {
        code = document.getElementById('readExampleCode')?.textContent || '';
      }

      const joltUrl = `http://blazeinferno64.github.io/jolt.html?code=${encodeURIComponent(code)}&run=true`;
      window.open(joltUrl, '_blank', 'noopener,noreferrer');
    }

    async function scanUploadedFile() {
      const input = document.getElementById('scanFileInput');
      const resultBox = document.getElementById('scanResult');
      const openLinkBtn = document.getElementById('scanOpenLink');
      if (!input?.files[0]) return alert('Select an image first.');
      openLinkBtn.style.display = 'none';
      const reader = new FileReader();
      reader.onload = async () => {
        resultBox.textContent = 'Analyzing...';
        try {
          const response = await fetch('/api/read', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ image: reader.result })
          });
          const data = await response.json();
          const decoded = data.response ? data.response : data.error;
          resultBox.textContent = decoded;
          try {
            const url = new URL(decoded.trim());
            if (url.protocol === 'https:' || url.protocol === 'http:') {
              openLinkBtn.href = url.href;
              openLinkBtn.style.display = 'flex';
            }
          } catch (_) {}
        } catch (e) {
          resultBox.textContent = 'Error decoding image.';
          openLinkBtn.style.display = 'none';
        }
      };
      reader.readAsDataURL(input.files[0]);
    }
  </script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/prism.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/components/prism-javascript.min.js"></script>
  <script src="https://cdn.jsdelivr.net/gh/BlazeInferno64/platformify.js@main/platformify.js"></script>
</body>

</html>
